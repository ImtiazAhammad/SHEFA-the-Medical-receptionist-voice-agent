; SHEFA <-> carrier SIP trunk. Rendered by `shefa asterisk render`; do not commit the output.
[transport-udp]
type=transport
protocol=udp
bind=0.0.0.0:5060
{{EXTERNAL_ADDRESS}}

; --- trunk ---
[trunk-auth]
type=auth
auth_type=userpass
username={{SIP_TRUNK_USER}}
password={{SIP_TRUNK_PASSWORD}}

[trunk-reg]
type=registration
transport=transport-udp
outbound_auth=trunk-auth
server_uri=sip:{{SIP_TRUNK_HOST}}:{{SIP_TRUNK_PORT}}
client_uri=sip:{{SIP_TRUNK_USER}}@{{SIP_TRUNK_HOST}}:{{SIP_TRUNK_PORT}}
retry_interval=60
expiration=300

[trunk]
type=aor
contact=sip:{{SIP_TRUNK_HOST}}:{{SIP_TRUNK_PORT}}

[trunk]
type=endpoint
transport=transport-udp
context=shefa-inbound
disallow=all
allow=alaw
allow=ulaw
outbound_auth=trunk-auth
aors=trunk
from_user={{SIP_TRUNK_USER}}
direct_media=no
rtp_symmetric=yes
force_rport=yes
rewrite_contact=yes
dtmf_mode=rfc4733

[trunk]
type=identify
endpoint=trunk
match={{SIP_TRUNK_HOST}}
; --- end trunk ---

{{SOFTPHONE_BLOCK}}
