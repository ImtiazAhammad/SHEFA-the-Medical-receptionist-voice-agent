# /etc/shefa/shefa.env  (mode 0600, owned by root or the shefa user). Never commit the real one.

# Key that encrypts transcripts and call-back details on disk. Generate once:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# BACK THIS UP SEPARATELY FROM THE DATABASE. Lose it and the stored words cannot be read.
SHEFA_DATA_KEY=

# Asterisk ARI password and the carrier trunk (see docs/asterisk-setup.md).
ARI_PASSWORD=
SIP_TRUNK_HOST=
SIP_TRUNK_USER=
SIP_TRUNK_PASSWORD=

# A line to ring when SHEFA itself is down, e.g. PJSIP/1001 or PJSIP/trunk/+8801700000000.
FALLBACK_DIAL=

# Only if the box has an NVIDIA GPU and you use vLLM: nothing else is needed.
# VLLM_USE_FLASHINFER_SAMPLER=0 is already set by SHEFA.
