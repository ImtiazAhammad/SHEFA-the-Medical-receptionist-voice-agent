{"nodes": [{"id": "docs_superpowers_specs_2026_10_01_shefa_owner_console_owner_console_plan", "label": "CEO Plan: SHEFA Owner Console and Lead Operations", "file_type": "document", "source_file": "docs/superpowers/specs/2026-10-01-shefa-owner-console.md", "source_location": "L9", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_specs_2026_10_01_shefa_owner_console_lead_to_human_atomic_loop", "label": "Captured lead reaches a human in under 60 seconds", "file_type": "rationale", "source_file": "docs/superpowers/specs/2026-10-01-shefa-owner-console.md", "source_location": "L23", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A product that only reports what happened gets cancelled; the console is the system of record for the loop, not its delivery mechanism."}, {"id": "docs_superpowers_specs_2026_10_01_shefa_owner_console_audit_findings", "label": "Audit-verified backend gaps (no leads, hours, persistence, browser auth, i18n, UI tests)", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-10-01-shefa-owner-console.md", "source_location": "L35", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_specs_2026_10_01_shefa_owner_console_fake_sent_true_handoff", "label": "Handoff returns sent:true without sending", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-10-01-shefa-owner-console.md", "source_location": "L47", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_specs_2026_10_01_shefa_owner_console_real_notification_delivery", "label": "Real lead notification delivery with attempts", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-10-01-shefa-owner-console.md", "source_location": "L343", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_specs_2026_10_01_shefa_owner_console_browser_auth_model", "label": "Browser auth: pasted bearer token held in memory only", "file_type": "rationale", "source_file": "docs/superpowers/specs/2026-10-01-shefa-owner-console.md", "source_location": "L142", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Never localStorage (PHI plus XSS) and no session cookie, so no CSRF change; re-entry is the right friction on a shared clinic machine."}, {"id": "docs_superpowers_specs_2026_10_01_shefa_owner_console_no_public_route_invariant", "label": "No route becomes public (T7 invariant)", "file_type": "rationale", "source_file": "docs/superpowers/specs/2026-10-01-shefa-owner-console.md", "source_location": "L150", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A PUBLIC_PATHS allowlist breaks tested fail-closed behaviour and publishes the bundle, trading a security invariant for cosmetic convenience."}, {"id": "docs_superpowers_specs_2026_10_01_shefa_owner_console_coverage_status_two_facts", "label": "Coverage status as two facts (in_open_hours, escalation_roster_configured)", "file_type": "rationale", "source_file": "docs/superpowers/specs/2026-10-01-shefa-owner-console.md", "source_location": "L185", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A configured roster and a reachable human are different promises, so they are never merged into a single word like 'covered'."}, {"id": "docs_superpowers_specs_2026_10_01_shefa_owner_console_take_over_lifecycle", "label": "Terminal desk-phone take-over lifecycle", "file_type": "rationale", "source_file": "docs/superpowers/specs/2026-10-01-shefa-owner-console.md", "source_location": "L217", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Take-over is terminal because the transfer dials a separate leg and the stream's finally cancels the pipeline; resuming mid-conflict is a worse failure than not resuming."}, {"id": "docs_superpowers_specs_2026_10_01_shefa_owner_console_seal_at_handoff", "label": "seal_at_handoff deliverable", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-10-01-shefa-owner-console.md", "source_location": "L260", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Flag-before-write ordering stops a racing turn from resurrecting a sealed transcript."}, {"id": "docs_superpowers_specs_2026_10_01_shefa_owner_console_callback_number_verified", "label": "callback_number_verified read-back flag", "file_type": "rationale", "source_file": "docs/superpowers/specs/2026-10-01-shefa-owner-console.md", "source_location": "L58", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Per-field STT confidence does not exist, and utterance confidence is meaningless at two of three providers; a read-back confirm is the honest signal."}, {"id": "docs_superpowers_specs_2026_10_01_shefa_owner_console_lead_correction_workflow", "label": "Lead correction workflow (lead_corrections audit rows)", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-10-01-shefa-owner-console.md", "source_location": "L280", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A wrong digit means calling a stranger, so a correction invalidates and re-queues in-flight notifications. Corrections do not feed the model in v1."}, {"id": "docs_superpowers_specs_2026_10_01_shefa_owner_console_phi_field_encryption", "label": "AES-256-GCM field encryption, masking and lead retention", "file_type": "rationale", "source_file": "docs/superpowers/specs/2026-10-01-shefa-owner-console.md", "source_location": "L288", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The callback number must be dialable so hashing is not an option; only this column needs field-level encryption and a missing key must fail the boot."}, {"id": "docs_superpowers_specs_2026_10_01_shefa_owner_console_schema_version_migrations", "label": "schema_version table with forward-only migrations", "file_type": "rationale", "source_file": "docs/superpowers/specs/2026-10-01-shefa-owner-console.md", "source_location": "L74", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A down() that silently drops a PHI column is worse than a manual restore; failed migrations abort the boot rather than start half-migrated."}, {"id": "docs_superpowers_specs_2026_10_01_shefa_owner_console_live_snapshot_polling", "label": "2s polling of /api/v1/owner/live (single worker)", "file_type": "rationale", "source_file": "docs/superpowers/specs/2026-10-01-shefa-owner-console.md", "source_location": "L91", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "At 1-2 concurrent pilot calls a 2s snapshot looks like streaming and adds no transport surface; SSE waits for clinic 2. The registry is process-local, so one worker is required."}, {"id": "docs_superpowers_specs_2026_10_01_shefa_owner_console_call_control_registry", "label": "CallControl process-global leg registry and CallLeg interface", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-10-01-shefa-owner-console.md", "source_location": "L98", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_specs_2026_10_01_shefa_owner_console_client_side_i18n", "label": "Client-side Bangla string table (drop jinja2)", "file_type": "rationale", "source_file": "docs/superpowers/specs/2026-10-01-shefa-owner-console.md", "source_location": "L118", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The smaller change across six screens with no SEO need, and it keeps the app a static bundle."}, {"id": "docs_superpowers_specs_2026_10_01_shefa_owner_console_multi_clinic_tenancy", "label": "Multi-clinic tenancy (clinic_id on all tables)", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-10-01-shefa-owner-console.md", "source_location": "L135", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Distribution is the sale: clinic 2 should be a sale, not a rewrite."}, {"id": "docs_superpowers_specs_2026_10_01_shefa_owner_console_d11_gate_overruled", "label": "D11 halt gate deliberately overruled", "file_type": "rationale", "source_file": "docs/superpowers/specs/2026-10-01-shefa-owner-console.md", "source_location": "L316", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "No investment and a fully local stack make a working product the asset to approach clinics with; recorded as a reversal, not an oversight."}, {"id": "docs_superpowers_specs_2026_10_01_shefa_owner_console_child_build_order", "label": "Build order: Child 0, Child 3, Child 5, Child 4", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-10-01-shefa-owner-console.md", "source_location": "L351", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The latency measurement stays last because only it is gated on the unlanded SIP trunk."}, {"id": "docs_superpowers_specs_2026_10_01_shefa_owner_console_bangla_piper_voice_blocker", "label": "Bangla Piper voice bn_BD.nf_cycgan.onnx named blocker", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-10-01-shefa-owner-console.md", "source_location": "L407", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_specs_2026_10_01_shefa_owner_console_freeswitch_bridge_unlanded", "label": "SIP trunk and FreeSWITCH bridge unlanded", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-10-01-shefa-owner-console.md", "source_location": "L406", "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"sour