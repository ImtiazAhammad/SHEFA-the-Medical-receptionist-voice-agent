{"nodes": [{"id": "docs_designs_shefa_safety_net_wedge_safety_net_wedge_design", "label": "SHEFA Safety-Net Wedge Design", "file_type": "document", "source_file": "docs/designs/shefa-safety-net-wedge.md", "source_location": "L1", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Narrows two parallel wedges to one door-shaped wedge; bookings, network telephony, HMS and push-selling stay in the roadmap and out of the pitch."}, {"id": "docs_designs_shefa_safety_net_wedge_telephony_rev1", "label": "Revision 1: Asterisk/FreeSWITCH + BD SIP Trunk", "file_type": "rationale", "source_file": "docs/designs/shefa-safety-net-wedge.md", "source_location": "L9", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Twilio BD number procurement is a confirmed build-blocker, so the media path runs local and open source; the SIP operator supplies PSTN reachability only."}, {"id": "docs_designs_shefa_safety_net_wedge_unmanned_windows", "label": "Unmanned Windows (Lunch, Prayer, Shift Handover)", "file_type": "concept", "source_file": "docs/designs/shefa-safety-net-wedge.md", "source_location": "L61", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Build conditional coverage for known staffing gaps rather than aspirational 24/7 replacement."}, {"id": "docs_designs_shefa_safety_net_wedge_number_maze", "label": "Multi-Branch Number Maze", "file_type": "concept", "source_file": "docs/designs/shefa-safety-net-wedge.md", "source_location": "L23", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Networks such as Ibn Sina keep separate numbers per branch, so patients burn time finding the right line; the network play is phase two."}, {"id": "docs_designs_shefa_safety_net_wedge_callback_lead", "label": "Callback Lead Value Unit", "file_type": "concept", "source_file": "docs/designs/shefa-safety-net-wedge.md", "source_location": "L85", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Name, number and reason captured in Bangla and texted to the desk require no booking trust on day one."}, {"id": "docs_designs_shefa_safety_net_wedge_global_category", "label": "Global Safety-Net Tier Benchmarks (MedCalls, Sully.ai, Clara, VoxAI, AI VOX)", "file_type": "concept", "source_file": "docs/designs/shefa-safety-net-wedge.md", "source_location": "L47", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Proves the problem is real and priced at $150-500/mo, but does not prove a single Dhaka owner will say yes."}, {"id": "docs_designs_shefa_safety_net_wedge_loop_unproven_p2", "label": "P2 Loop Must Be Proven Before Outreach", "file_type": "rationale", "source_file": "docs/designs/shefa-safety-net-wedge.md", "source_location": "L110", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The answering loop has never run end to end with a real call, so proof and per-turn latency precede any pitch."}, {"id": "docs_designs_shefa_safety_net_wedge_one_pitch_object_p3", "label": "P3 One Pitch Object", "file_type": "rationale", "source_file": "docs/designs/shefa-safety-net-wedge.md", "source_location": "L114", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The same drop-call story lands on single-branch and network lists, closing the two-builds trap."}, {"id": "docs_designs_shefa_safety_net_wedge_live_trial_evidence_p4", "label": "P4 One-Week Live Trial as Evidence", "file_type": "rationale", "source_file": "docs/designs/shefa-safety-net-wedge.md", "source_location": "L117", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Revised after cross-model challenge: a demo proves technical feasibility only, so real caller behavior is the evidence. Folds the 9/22 shadow line into the answering wedge."}, {"id": "docs_designs_shefa_safety_net_wedge_approach_a_safety_net_capture", "label": "Approach A: Safety-Net Capture (Chosen)", "file_type": "concept", "source_file": "docs/designs/shefa-safety-net-wedge.md", "source_location": "L150", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The smallest thing an owner lets a stranger touch their phone line for, and it produces live-caller evidence in the same week it runs."}, {"id": "docs_designs_shefa_safety_net_wedge_approach_b_live_trial_agent", "label": "Approach B: Live-Trial Coverage Agent", "file_type": "concept", "source_file": "docs/designs/shefa-safety-net-wedge.md", "source_location": "L169", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The real product and upgrade path, but booking trust is the last thing an owner grants a stranger."}, {"id": "docs_designs_shefa_safety_net_wedge_approach_c_demo_shadow", "label": "Approach C: Demo Theater + Shadow Line", "file_type": "concept", "source_file": "docs/designs/shefa-safety-net-wedge.md", "source_location": "L182", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Rejected on 9/22 and again in session: a passive log defines what is missed, not what SHEFA catches, and keeps two sales stories."}, {"id": "docs_designs_shefa_safety_net_wedge_agent_behavior", "label": "Safety-Net Agent Behavior", "file_type": "concept", "source_file": "docs/designs/shefa-safety-net-wedge.md", "source_location": "L199", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Configurable named windows, Bangla-first greeting with disclosure, and logged per-call metrics held to the 2s target."}, {"id": "docs_designs_shefa_safety_net_wedge_capture_loop", "label": "Name-Callback-Reason Capture Loop", "file_type": "concept", "source_file": "docs/designs/shefa-safety-net-wedge.md", "source_location": "L211", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Read-back confirmation plus structured intents (appointment, result inquiry, billing, other)."}, {"id": "docs_designs_shefa_safety_net_wedge_emergency_escalation", "label": "Emergency Transfer, No Medical Advice", "file_type": "concept", "source_file": "docs/designs/shefa-safety-net-wedge.md", "source_location": "L214", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Emergency keywords trigger immediate warm handoff to a human; SHEFA never gives medical advice."}, {"id": "docs_designs_shefa_safety_net_wedge_degrade_path", "label": "Degrade-to-Transfer Path", "file_type": "concept", "source_file": "docs/designs/shefa-safety-net-wedge.md", "source_location": "L216", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "On STT, TTS or LLM failure: fixed courtesy message, DTMF callback capture, or transfer."}, {"id": "docs_designs_shefa_safety_net_wedge_data_handling", "label": "Safety-Net Data Handling", "file_type": "rationale", "source_file": "docs/designs/shefa-safety-net-wedge.md", "source_location": "L238", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Disclosure, T+14 retention and read-only owner access; data-stays-on-site is the end state, not week-one reality."}, {"id": "docs_designs_shefa_safety_net_wedge_go_no_go_gate", "label": "Revised Go / No-Go Gate (One-Wedge)", "file_type": "concept", "source_file": "docs/designs/shefa-safety-net-wedge.md", "source_location": "L265", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Adds a loop-closure stop: if the loop cannot close within 2 weeks the product premise is not yet buildable."}, {"id": "docs_designs_shefa_safety_net_wedge_spend_cap", "label": "Hard Trial-Week Spend Cap (~$10)", "file_type": "concept", "source_file": "docs/designs/shefa-safety-net-wedge.md", "source_location": "L279