{"nodes": [{"id": "docs_designs_shefa_first_clinic_first_clinic_strategy", "label": "SHEFA First-Clinic Strategy: Shadow Line + Door-Opener", "file_type": "document", "source_file": "docs/designs/shefa-first-clinic.md", "source_location": "L3", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The binding constraint is the first door (a named clinic owner), not the product, and demand evidence must be manufactured."}, {"id": "docs_designs_shefa_first_clinic_conviction_sale", "label": "Conviction Sale Posture", "file_type": "concept", "source_file": "docs/designs/shefa-first-clinic.md", "source_location": "L30", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "No clinic has asked for this, so the pitch lives or dies on proving pain inside a real org rather than on interest in the idea."}, {"id": "docs_designs_shefa_first_clinic_measurement_precondition", "label": "Measurement Precondition (Premise 2)", "file_type": "rationale", "source_file": "docs/designs/shefa-first-clinic.md", "source_location": "L77", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The 2,000+ calls and 4-5 retries figures are beliefs; one week of real call records is required before any ROI pitch, and retries overcount unique lost bookings."}, {"id": "docs_designs_shefa_first_clinic_land_and_expand", "label": "Land-and-Expand via Complementary HMS Wedge", "file_type": "concept", "source_file": "docs/designs/shefa-first-clinic.md", "source_location": "L85", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Front-desk wedge sits beside the incumbent HMS with AI-first HMS as roadmap; conquest language stays out of material the vendor or clinic IT might read."}, {"id": "docs_designs_shefa_first_clinic_booking_revenue_unit", "label": "Booking as Revenue Unit", "file_type": "concept", "source_file": "docs/designs/shefa-first-clinic.md", "source_location": "L98", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Phone answering without a booking the desk trusts is voicemail with extra steps."}, {"id": "docs_designs_shefa_first_clinic_approach_a_door_opener", "label": "Approach A: The Door-Opener", "file_type": "concept", "source_file": "docs/designs/shefa-first-clinic.md", "source_location": "L118", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Fastest path to a ringing line and demo theater, but undersells the dialogue and carries no data on its own."}, {"id": "docs_designs_shefa_first_clinic_approach_b_booking_engine", "label": "Approach B: The Booking Engine", "file_type": "concept", "source_file": "docs/designs/shefa-first-clinic.md", "source_location": "L125", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Builds the moat of a trusted booking record but is the most speculative before a door opens, since HMS constraints are unverifiable."}, {"id": "docs_designs_shefa_first_clinic_approach_c_shadow_line", "label": "Approach C: The Shadow Line", "file_type": "concept", "source_file": "docs/designs/shefa-first-clinic.md", "source_location": "L132", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Passive overflow capture manufactures the missing evidence so the owner sees their own numbers; week one earns log data, not bookings."}, {"id": "docs_designs_shefa_first_clinic_approach_d_after_hours", "label": "Approach D: After-Hours Receiver", "file_type": "concept", "source_file": "docs/designs/shefa-first-clinic.md", "source_location": "L425", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Hours with no human present have 100% baseline loss and zero employee optics; kept as the documented low-volume and objection-coded fallback."}, {"id": "docs_designs_shefa_first_clinic_recommended_a_plus_c", "label": "A + C in Parallel Recommendation", "file_type": "rationale", "source_file": "docs/designs/shefa-first-clinic.md", "source_location": "L152", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Each de-risks the other: log data makes the demo credible, the demo makes the data interesting. Fallback order is C then A."}, {"id": "docs_designs_shefa_first_clinic_ring_truncation_blind_spot", "label": "Sub-2-Ring Truncation Blind Spot", "file_type": "concept", "source_file": "docs/designs/shefa-first-clinic.md", "source_location": "L143", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Callers who hang up before the forward trigger never enter the log, truncating the abandonment distribution; flagged as a critical consent gap until UC3."}, {"id": "docs_designs_shefa_first_clinic_data_handling_policy", "label": "Health Telecom Data Handling Policy", "file_type": "rationale", "source_file": "docs/designs/shefa-first-clinic.md", "source_location": "L182", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Real patient calls require disclosure, T+14 retention and owner-only access; week-one hardware is pinned to the builder's machine and consent must say so."}, {"id": "docs_designs_shefa_first_clinic_go_no_go_gate", "label": "Go / No-Go Gate (First-Clinic)", "file_type": "concept", "source_file": "docs/designs/shefa-first-clinic.md", "source_location": "L221", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A conviction sale needs an explicit decision point rather than endless pitching: GO, NARROW or STOP/CLOSE after 2 weeks and 10-20 clinics."}, {"id": "docs_designs_shefa_first_clinic_draft_pricing", "label": "Draft Pricing Tiers", "file_type": "concept", "source_file": "docs/designs/shefa-first-clinic.md", "source_location": "L243", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Free pilot, Go tier BDT 3,000-6,000/mo, Expansion BDT 9,000-15,000/mo; marked DRAFT because no cost basis exists until procurement."}, {"id": "docs_designs_shefa_first_clinic_forward_verification_t1", "label": "T1 BD Number + Forward-on-No-Answer Verification", "file_type": "concept", "source_file": "docs/designs/shefa-first-clinic.md", "source_location": "L721", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A go/kill dependency that was scheduled too late."}, {"id": "docs_designs_shefa_first_clinic_call_log_sink_t2", "label": "T2 SQLite Call-Log Sink", "file_type": "concept", "source_file": "docs/designs/shefa-first-clinic.md", "source_location": "L724", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Separates raw missed from confirmed-lost and makes retention deletes auditable."}, {"id": "docs_designs_shefa_first_clinic_bangla_quality_bar_t3", "label": "T3 Bangla Booking-Loop Quality Bar", "file_type": "concept", "source_file": "docs/designs/shefa-first-clinic.md", "source_location": "L727", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Bangla quality is the moat, so it gets a gate: at least 3 of 4 clean complete bookings plus logged latency."}, {"id": "docs_designs_shefa_first_clinic_smoke_test_t4", "label": "T4 Cloud-vs-Local Smoke Test", "file_type": "concept", "source_file": "docs/designs/shefa-first-clinic.md", "source_location": "L730", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "An empirical, cheap stack decision that had never been compared."}, {"id": "docs_designs_shefa_first_clinic_hms_discovery_t5", "label": "T5 20-Minute HMS Discovery", "file_type": "concept", "source_file": "docs/designs/shefa-first-clinic.md", "source_location": "L733", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The one-line paste-in is an unverified moat assumption that must be tested on a real HMS."}, {"id": "docs_designs_shefa_first_clinic_outreach_tracker_t6", "label": "T6 Outreach Tracker + Objection Coding", "file_type": "concept", "source_file": "docs/designs/shefa-first-clinic.md", "source_location": "L736", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Named-on-a-list does not mean reachable owner; trust-coded objections route to the after-hours pitch."}, {"id": "docs_designs_shefa_first_clinic_encryption_deletion_t7", "label": "T7 Full-Disk Encryption + Raw-Audio Deletion", "file_type": "concept", "source_file": "docs/designs/shefa-first-clinic.md", "source_location": "L739", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A home GPU box holds patient health audio."}, {"id": "docs_designs_shefa_first_clinic_gate_metrics_t8", "label": "T8 Weekly Go/No-Go Progress Metrics", "file_type": "concept", "source_file": "docs/designs/shefa-first-clinic.md", "source_location": "L742", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A 2-week one-yes target is a vanity metric without leading indicators."}, {"id": "docs_designs_shefa_first_clinic_demo_storyboard_d1", "label": "D1 Five-Beat Demo Storyboard", "file_type": "concept", "source_file": "docs/designs/shefa-first-clinic.md", "source_location": "L957", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The emotional close was demoted to a supporting beat, so the demo becomes the first artifact the owner opens."}, {"id": "docs_designs_shefa_first_clinic_bangla_one_pager_d2", "label": "D2 One-Page Bangla Pitch", "file_type": "concept", "source_file": "docs/designs/shefa-first-clinic.md", "source_location": "L960", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Leads with the clinic's own traffic because 2,000 missed calls is unmeasured; consent is an explicit beat rather than a footnote."}, {"id": "docs_designs_shefa_first_clinic_warm_close_d3", "label": "D3 Post-Disclosure Warm Close + Reveal Scripts", "file_type": "concept", "source_file": "docs/designs/shefa-first-clinic.md", "source_location": "L962", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Dead air after disclosure is a trust killer; a missed 14 / lost 1 reveal torpedoes the pitch without a pre-written script."}, {"id": "docs_designs_shefa_first_clinic_dashboard_contract_d4", "label": "D4 Today's Calls Dashboard Contract", "file_type": "concept", "source_file": "docs/designs/shefa-first-clinic.md", "source_location": "L964", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A minimal view left layout and 4 of 7 states undefined; slow days are when owner belief is lowest."}, {"id": "docs_designs_shefa_first_clinic_integrity_check_d5", "label": "D5 Recording Indicator + Daily Integrity Check", "file_type": "concept", "source_file": "docs/designs/shefa-first-clinic.md", "source_location": "L967", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Logger, GPU or telephony failure would otherwise quietly corrupt the measurement week."}, {"id": "docs_designs_shefa_first_clinic_coder_workflow_d6", "label": "D6 Daily Coder Workflow", "file_type": "concept", "source_file": "docs/designs/shefa-first-clinic.md", "source_location": "L969", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A load-bearing human workflow: the builder codes daily and ambiguous calls default to general so booking intent is never guessed."}, {"id": "docs_designs_shefa_first_clinic_degraded_fallback_d7", "label": "D7 Degraded-Forwarding Fallback", "file_type": "concept", "source_file": "docs/designs/shefa-first-clinic.md", "source_location": "L971", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A second advertised line still yields real calls, so it is primary; numbers-only CDR analysis is the labelled last resort."}, {"id": "docs_designs_shefa_first_clinic_latency_ceiling_d8", "label": "D8 Latency Ceiling Pin", "file_type": "concept", "source_file": "docs/designs/shefa-first-clinic.md", "source_location": "L973", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Gives the smoke test a pass/fail; the 1.5s task wording is superseded by the accepted 2s median parse-to-reply."}, {"id": "docs_designs_shefa_first_clinic_two_number_reporting", "label": "Two-Number Reporting (Raw Missed vs Confirmed-Lost)", "file_type": "rationale", "source_file": "docs/designs/shefa-first-clinic.md", "source_location": "L312", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Prevents measurement inflation by never reporting one derived figure to the owner."}, {"id": "docs_designs_shefa_first_clinic_canonical_disposition_enum_x3", "label": "X3 Canonical 6-Value Disposition Enum", "file_type": "concept", "source_file": "docs/designs/shefa-first-clinic.md", "source_location": "L1140", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Retires a contradictory 3-value sketch; the predicate is booking intent, NOT re-called, NOT resolved by desk."}, {"id": "docs_designs_shefa_first_clinic_write_before_transcribe", "label": "Write-Before-Transcribe Crash Safety", "file_type": "rationale", "source_file": "docs/designs/shefa-first-clinic.md", "source_location": "L1043", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "For an audit-log deliverable a dropped record is the worst outcome, so metadata is written synchronously at ring-in before async work."}, {"id": "docs_designs_shefa_first_clinic_week_one_runbook_x1", "label": "X1 Week One Build / Runbook", "file_type": "concept", "source_file": "docs/designs/shefa-first-clinic.md", "source_location": "L1133", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The build was a sequence of verbs with no zero-to-running path."}, {"id": "docs_designs_shefa_first_clinic_twilio_fallbacks_x2", "label": "X2 Twilio-BD Fallbacks + Smoke Verdict Record", "file_type": "concept", "source_file": "docs/designs/shefa-first-clinic.md", "source_location": "L1137", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Number procurement is a vendor singleton gating measurement."}, {"id": "docs_designs_shefa_first_clinic_error_path_table_x4", "label": "X4 Error-Path Table + Quiet-vs-Dead Rule", "file_type": "concept", "source_file": "docs/designs/shefa-first-clinic.md", "source_location": "L1143", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Stack-level error paths were absent, and a silent day must be distinguishable from a broken line."}, {"id": "docs_designs_shefa_first_clinic_two_parse_handoff_x5", "label": "X5 Two-Failed-Parses Handoff", "file_type": "concept", "source_file": "docs/designs/shefa-first-clinic.md", "source_location": "L1146", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Promoted from a cross-model note into the call-flow spec so a caller never meets dead air."}, {"id": "docs_designs_shefa_first_clinic_build_spec_x6", "label": "X6 Canonical Build Spec + Dashboard Data Contract", "file_type": "concept", "source_file": "docs/designs/shefa-first-clinic.md", "source_location": "L1149", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Mandates lived in an appendix with no file references and no Definition of Done."}, {"id": "docs_designs_shefa_first_clinic_ops_runbook_x7", "label": "X7 ops/runbook.md Living Doc", "file_type": "concept", "source_file": "docs/designs/shefa-first-clinic.md", "source_location": "L1152", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Which doc was the living operational source was undefined; the shift log doubles as the audit citation."}, {"id": "docs_designs_shefa_first_clinic_dev_readme_x8", "label": "X8 dev/README Copy-Paste Docs", "file_type": "concept", "source_file": "docs/designs/shefa-first-clinic.md", "source_location": "L1155", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The plan contained zero copy-paste examples."}, {"id": "docs_designs_shefa_first_clinic_latency_reconcile_x9", "label": "X9 Latency Phrase Reconciliation", "file_type": "rationale", "source_file": "docs/designs/shefa-first-clinic.md", "source_location": "L1177", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "SF_LATENCY_MS holds one value, so docs and titles sweep to the single 2s median parse-to-reply phrase."}, {"id": "docs_designs_shefa_first_clinic_sf_config_keys", "label": "SF_N_RINGS / SF_LATENCY_MS / SF_SPEND_CAP Config Keys", "file_type": "concept", "source_file": "docs/designs/shefa-first-clinic.md", "source_location": "L1074", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Headline defaults had no config surface; the ring caveat must render the actual N rather than a hardcoded 2."}, {"id": "docs_designs_shefa_first_clinic_webhook_security_e1", "label": "E1 Webhook HMAC + Idempotency + Dashboard Auth", "file_type": "concept", "source_file": "docs/designs/shefa-first-clinic.md", "source_location": "L1373", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Anyone could POST fake CallSids and corrupt the manufactured evidence; a single public reverse proxy must not serve both surfaces."}, {"id": "docs_designs_shefa_first_clinic_ani_reliability_e2", "label": "E2 ANI Reliability + Hashed Dedup", "file_type": "concept", "source_file": "docs/designs/shefa-first-clinic.md", "source_location": "L1376", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Forwarded legs often present the clinic number or anonymous, breaking the retry count and unique-caller dedup."}, {"id": "docs_designs_shefa_first_clinic_three_bucket_reporting_e3", "label": "E3 re_called_evidence + 3-Bucket Reporting", "file_type": "concept", "source_file": "docs/designs/shefa-first-clinic.md", "source_location": "L1378", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Confirmed-lost is not observable from a passive line because callers retry the main line; provenance comes from a daily clinic check-in."}, {"id": "docs_designs_shefa_first_clinic_forward_semantics_e4", "label": "E4 Honest Forward Semantics + verified_rings", "file_type": "concept", "source_file": "docs/designs/shefa-first-clinic.md", "source_location": "L1381", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Audio starts only after N clinic-side rings, so disclosure from ring one is physically impossible and is labelled at answer, post-ring-N."}, {"id": "docs_designs_shefa_first_clinic_disclosure_failure_e5", "label": "E5 Disclosure-Failure Terminate + Pre-Rendered Clips", "file_type": "concept", "source_file": "docs/designs/shefa-first-clinic.md", "source_location": "L1384", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Recording after a failed disclosure is silent transcription; pre-rendering removes TTS from the live path."}, {"id": "docs_designs_shefa_first_clinic_cloud_escape_e6", "label": "E6 Cloud Escape Restricted to Synthetic Audio", "file_type": "concept", "source_file": "docs/designs/shefa-first-clinic.md", "source_location": "L1386", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Rerouting real patient call