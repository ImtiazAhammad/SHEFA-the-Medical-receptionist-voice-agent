{"nodes": [{"id": "docs_designs_shefa_first_clinic_disposition_disposition_table", "label": "SHEFA First-Clinic Original-Item Disposition Table", "file_type": "document", "source_file": "docs/designs/shefa-first-clinic-disposition.md", "source_location": "L1", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "D-ENG19 observed that re-scoping would silently drop original plan items with no owning child; every item must carry IN, RE-SCOPED or DROPPED plus a reason."}, {"id": "docs_designs_shefa_first_clinic_disposition_disposition_keys", "label": "Disposition Keys (IN / RE-SCOPED / DROPPED)", "file_type": "rationale", "source_file": "docs/designs/shefa-first-clinic-disposition.md", "source_location": "L42", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A DROPPED row is only valid when superseded by a later recorded decision, so omission cannot pass as a decision."}, {"id": "docs_designs_shefa_first_clinic_disposition_t1_rescope", "label": "T1 Re-scope to 2 SIP-Trunk Fallbacks", "file_type": "rationale", "source_file": "docs/designs/shefa-first-clinic-disposition.md", "source_location": "L49", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "3 candidate clinics narrowed to 2 concrete SIP-trunk fallbacks; the SIP spend guard replaces per-call Twilio cost capture."}, {"id": "docs_designs_shefa_first_clinic_disposition_t3_rescope", "label": "T3 Re-scope of Bangla Booking-Loop Bar", "file_type": "rationale", "source_file": "docs/designs/shefa-first-clinic-disposition.md", "source_location": "L51", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "No owning child as stated, so quality asserts move to Child 2 and Child 7 tests and the latency gate to Child 4."}, {"id": "docs_designs_shefa_first_clinic_disposition_t6_dropped", "label": "T6 Dropped: Outreach Is the Gate, Not Code", "file_type": "rationale",