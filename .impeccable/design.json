  "components": [
    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Going ahead: book, save, confirm. Settled green.",
      "html": "<button class=\"ds-btn ds-btn-primary\"><svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M20 6 9 17l-5-5\"/></svg> নিশ্চিত করুন</button>",
      "css": ".ds-btn{display:inline-flex;align-items:center;justify-content:center;gap:.45rem;min-height:44px;padding:.5rem 1.05rem;border:1px solid var(--rule-strong);border-radius:var(--r-sm);background:var(--box);color:var(--ink);font:inherit;font-family:var(--font-display);font-weight:600;line-height:1.2;cursor:pointer;transition:background-color .15s var(--ease-out),border-color .15s var(--ease-out),box-shadow .15s var(--ease-out);} .ds-btn-primary{background:var(--primary);border-color:var(--primary);color:var(--on-primary);} .ds-btn-primary:hover{background:var(--primary-hover);border-color:var(--primary-hover);} .ds-btn:focus-visible{outline:3px solid var(--focus);outline-offset:2px;} .ds-btn:active{box-shadow:none;}"
    },
    {
      "name": "Default Button",
      "kind": "button",
      "refersTo": "button",
      "description": "Every ordinary action: a box-face button with a strong rule stroke.",
      "html": "<button class=\"ds-btn-default\">হয়েছে: কল করেছি</button>",
      "css": ".ds-btn-default{display:inline-flex;align-items:center;justify-content:center;gap:.45rem;min-height:44px;padding:.5rem 1.05rem;border:1px solid var(--rule-strong);border-radius:var(--r-sm);background:var(--box);color:var(--ink);font:inherit;font-family:var(--font-display);font-weight:600;line-height:1.2;cursor:pointer;transition:background-color .15s var(--ease-out),border-color .15s var(--ease-out),box-shadow .15s var(--ease-out);} .ds-btn-default:hover{border-color:var(--ink-2);box-shadow:var(--shadow-box);} .ds-btn-default:active{background:var(--box-2);box-shadow:none;} .ds-btn-default:focus-visible{outline:3px solid var(--focus);outline-offset:2px;}"
    },
    {
      "name": "SHEFA Button",
      "kind": "button",
      "refersTo": "button-shefa",
      "description": "An action that hands work to SHEFA. SHEFA blue.",
      "html": "<button class=\"ds-btn-shefa\">শেফাকে দিন</button>",
      "css": ".ds-btn-shefa{display:inline-flex;align-items:center;justify-content:center;gap:.45rem;min-height:44px;padding:.5rem 1.05rem;border:1px solid var(--rule-strong);border-radius:var(--r-sm);background:var(--box);color:var(--ink);font:inherit;font-family:var(--font-display);font-weight:600;line-height:1.2;cursor:pointer;transition:background-color .15s var(--ease-out),border-color .15s var(--ease-out),box-shadow .15s var(--ease-out);background:var(--shefa);border-color:var(--shefa);color:var(--on-shefa);} .ds-btn-shefa:hover{background:var(--shefa-ink);border-color:var(--shefa-ink);} .ds-btn-shefa:focus-visible{outline:3px solid var(--focus);outline-offset:2px;}"
    },
    {
