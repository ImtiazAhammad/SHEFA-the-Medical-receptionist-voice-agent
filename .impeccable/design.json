      "html": "<label class=\"ds-field\"><span>রোগীর নাম</span><input class=\"ds-input\" placeholder=\"নাম লিখুন\"></label>",
      "css": ".ds-field{display:inline-grid;gap:.2rem;} .ds-field>span{font-size:var(--step--1);font-weight:600;color:var(--ink-2);} .ds-input{font:inherit;color:var(--ink);background:var(--box);border:1px solid var(--rule-strong);border-radius:var(--r-sm);min-height:44px;padding:.45rem .75rem;} .ds-input:hover{border-color:var(--ink-3);} .ds-input:focus-visible{outline:0;border-color:var(--focus);box-shadow:0 0 0 3px var(--shefa-wash);} .ds-input::placeholder{color:var(--ink-3);}"
