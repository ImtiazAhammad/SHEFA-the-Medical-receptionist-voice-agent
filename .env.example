# MedVoice Receptionist Environment Variables
# Copy to .env and fill in values

# --- API Keys ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
ELEVENLABS_API_KEY=

# --- Twilio ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# --- Database ---
DATABASE_URL=postgresql+asyncpg://medvoice:medvoice@localhost:5432/medvoice
REDIS_URL=redis://localhost:6379/0

# --- Authentication ---
# Nothing secret lives here. Tokens have never had a "secret key" in this
# project (T7 removed the two fake values that used to sit in this section);
# each API token is an opaque high-entropy string kept out of the repo and
# onboarded as a PBKDF2-SHA256 record via `sefa token`.

# --- App ---
APP_HOST=127.0.0.1
APP_PORT=8000
ENVIRONMENT=development
LOG_LEVEL=INFO

# --- Compliance ---
HIPAA_AUDIT_LOG_PATH=/var/log/medvoice/audit
CALL_RECORDING_BUCKET=
