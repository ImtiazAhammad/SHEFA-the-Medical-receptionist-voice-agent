# MedVoice Receptionist Environment Variables
# Copy to .env and fill in values

# --- API Keys ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
ELEVENLABS_API_KEY=

# --- Twilio ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# --- Database ---
DATABASE_URL=postgresql+asyncpg://medvoice:medvoice@localhost:5432/medvoice
REDIS_URL=redis://localhost:6379/0

# --- Security ---
JWT_SECRET_KEY=
ENCRYPTION_KEY=

# --- App ---
APP_HOST=0.0.0.0
APP_PORT=8000
ENVIRONMENT=development
LOG_LEVEL=INFO

# --- Compliance ---
HIPAA_AUDIT_LOG_PATH=/var/log/medvoice/audit
CALL_RECORDING_BUCKET=
